# Optional overrides. The defaults live in src/config/launch.ts and can be changed there with a commit.
# A value set here (or on Vercel) wins over the file.

# "production" hides every unverified claim. Anything else (or unset) is draft mode: placeholders are shown.
NEXT_PUBLIC_SITE_MODE=draft

# Staging by default: the site is noindex everywhere. Set to "true" (together with
# NEXT_PUBLIC_SITE_MODE=production) only on launch day. *.vercel.app URLs stay noindex regardless.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public site URL, used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://appliancerepairtemple.com

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile. Both keys are needed for spam protection beyond the honeypot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where lead submissions are POSTed as JSON (Zapier, Make, CRM, email relay).
# When empty, leads are written to the server log only.
LEAD_WEBHOOK_URL=
